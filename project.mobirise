    "index.html": {
      "settings": {
        "main": true,
        "title": "构图在线展示练习 | Film Composition",
        "meta_descr": "以构图为基础的影像练习，\n专注于画面平衡、空间关系与视觉叙事的呈现。",
        "header_custom": "",
